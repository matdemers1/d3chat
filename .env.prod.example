# Cloudflare Tunnel token (from Zero Trust dashboard → Tunnels → d3chat)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# PostgreSQL password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# JWT signing secret — generate with: openssl rand -base64 48
SECRET_KEY=change-me

# Ed25519 signing key seed for persistent federation identity — generate with: openssl rand -hex 32
SIGNING_KEY_SEED=change-me
